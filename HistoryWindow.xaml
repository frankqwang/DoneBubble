<Window x:Class="DoneBubble.HistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DoneBubble" Title="DoneBubble · 今天" Width="900" Height="620" MinWidth="680" MinHeight="420" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="#EDF2F7" FontFamily="Segoe UI, Microsoft YaHei UI" ShowInTaskbar="False" Topmost="False" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown" SizeChanged="Window_SizeChanged">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="Bool"/><local:Base64ImageConverter x:Key="Base64Image"/><local:JsonFormatConverter x:Key="JsonFormat"/>
  <Style TargetType="ScrollBar"><Setter Property="Background" Value="#151C27"/><Setter Property="Foreground" Value="#53657A"/><Setter Property="Width" Value="8"/><Setter Property="MinWidth" Value="8"/><Setter Property="Opacity" Value="0.9"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="8"/><Setter Property="MinHeight" Value="8"/><Setter Property="Width" Value="Auto"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Border Margin="8" Background="#F5222B38" CornerRadius="18" BorderBrush="#4C596B" BorderThickness="1" Padding="20" MouseLeftButtonDown="Window_Drag">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid MouseLeftButtonDown="Header_Drag"><StackPanel><TextBlock Text="今天" Foreground="#A8CFC0" FontSize="12"/><TextBlock Text="{Binding Heading}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,16"/></StackPanel><Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Padding="7,0" FontSize="20" Click="Close_Click" ToolTip="关闭 (Esc)"/></Grid>
   <Grid x:Name="LayoutGrid" Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Grid.Column="0">
     <TextBlock Text="还没有记录。&#10;处理完一件事，点一下气泡就好。" TextAlignment="Center" VerticalAlignment="Center" Foreground="#9EA9B8" LineHeight="26" Visibility="{Binding IsEmpty, Converter={StaticResource Bool}}"/>
     <ListBox x:Name="RecordList" ItemsSource="{Binding Records}" SelectionChanged="Record_SelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="#2B3544" CornerRadius="10" Padding="12"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#3B5364"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Time}" Foreground="#9EA9B8" FontSize="12" Margin="0,3,0,0"/><TextBlock Grid.Column="1" Text="{Binding DisplayContent}" Foreground="#EDF2F7" TextWrapping="Wrap" Margin="0,0,8,0" FontSize="14"/><Button Grid.Column="2" Content="×" Tag="{Binding}" Click="Delete_Click" Padding="6,0" Background="Transparent" Foreground="#A8B3C1" VerticalAlignment="Top" ToolTip="删除误记录"/></Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>
    <Border x:Name="DetailsPanel" Grid.Column="2" Background="#2B3544" CornerRadius="12" Padding="16">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="AI总结" Foreground="#A8CFC0" FontSize="13"/>
      <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=SelectedRecord.DisplayContent}" FontSize="18" TextWrapping="Wrap" Margin="0,5,0,14"/>
      <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=SelectedLog.Summary}" FontSize="20" TextWrapping="Wrap" Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=HasSelectedLog, Converter={StaticResource Bool}}"/>
      <TextBlock Text="这条记录没有 AI 总结" Foreground="#9EA9B8" Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=HasNoSelectedLog, Converter={StaticResource Bool}}"/>
      <TextBlock Text="截图证据（代表图）" Foreground="#A8CFC0" FontSize="13" Margin="0,16,0,7"/>
      <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=FrameHint}" Foreground="#8795A7" FontSize="11" Margin="0,0,0,7"/>
      <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DisplayedFrames}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="#151C27" CornerRadius="8" Padding="4" Margin="0,0,8,8"><Image Source="{Binding Converter={StaticResource Base64Image}}" Width="150" Height="92" Stretch="Uniform"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="提示词" Foreground="#A8CFC0" FontSize="13" Margin="0,10,0,6" Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=HasSelectedLog, Converter={StaticResource Bool}}"/>
      <TextBox Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=SelectedLog.Prompt}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Background="#151C27" Foreground="#DCE5EE" BorderThickness="0" Padding="12" FontSize="13" MinHeight="100" Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=HasSelectedLog, Converter={StaticResource Bool}}"/>
      <TextBlock Text="模型原始输出" Foreground="#A8CFC0" FontSize="13" Margin="0,14,0,6" Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=HasSelectedLog, Converter={StaticResource Bool}}"/>
      <TextBox Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=SelectedLog.RawResponse, Converter={StaticResource JsonFormat}}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Background="#151C27" Foreground="#DCE5EE" BorderThickness="0" Padding="12" FontSize="13" MinHeight="140" Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=HasSelectedLog, Converter={StaticResource Bool}}"/>
     </StackPanel></ScrollViewer>
    </Border>
   </Grid>
   <Grid Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="已经做了的，都算数。" Foreground="#9EA9B8" VerticalAlignment="Center" FontSize="12"/><TextBlock Text="自动更新" HorizontalAlignment="Right" Foreground="#728195" FontSize="12" VerticalAlignment="Center"/></Grid>
  </Grid>
 </Border>
</Window>
