<Window x:Class="DoneBubble.HistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DoneBubble · 今日记录" Width="420" Height="510" MinWidth="340" MinHeight="280" Background="#202936" Foreground="#EDF2F7" FontFamily="Segoe UI, Microsoft YaHei UI" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="CenterScreen">
 <Window.Resources><BooleanToVisibilityConverter x:Key="Bool"/></Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="今天" Foreground="#A8CFC0" FontSize="12"/><TextBlock Text="{Binding Heading}" FontSize="23" FontWeight="SemiBold" Margin="0,6,0,18"/></StackPanel>
  <TextBlock Grid.Row="1" Text="{Binding Error}" Visibility="{Binding HasError, Converter={StaticResource Bool}}" Foreground="#FFB8AE" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <Grid Grid.Row="2">
   <TextBlock Text="还没有记录。&#10;处理完一件事，点一下气泡就好。" TextAlignment="Center" VerticalAlignment="Center" Foreground="#9EA9B8" LineHeight="26" Visibility="{Binding IsEmpty, Converter={StaticResource Bool}}"/>
   <ListBox ItemsSource="{Binding Records}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><Border Background="#2B3544" CornerRadius="10" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Time}" Foreground="#9EA9B8" FontSize="12" Margin="0,3,0,0"/><TextBlock Grid.Column="1" Text="{Binding DisplayContent}" Foreground="#EDF2F7" TextWrapping="Wrap" Margin="0,0,10,0" FontSize="14"/><Button Grid.Column="2" Content="×" Tag="{Binding}" Click="Delete_Click" Padding="6,0" Background="Transparent" Foreground="#A8B3C1" VerticalAlignment="Top" ToolTip="删除误记录" AutomationProperties.Name="删除这条记录"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </Grid>
  <Grid Grid.Row="3" Margin="0,16,0,0"><TextBlock Text="已经做了的，都算数。" Foreground="#9EA9B8" VerticalAlignment="Center" FontSize="12"/><Button Content="刷新" HorizontalAlignment="Right" Click="Refresh_Click"/></Grid>
 </Grid>
</Window>
