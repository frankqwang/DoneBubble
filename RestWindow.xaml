<Window x:Class="DoneBubble.RestWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DoneBubble · 休息" Width="240" Height="172" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="#EDF2F7" UseLayoutRounding="True">
 <Border Margin="8" Padding="16,12" CornerRadius="18" Background="#F52B3B35">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="休息一下 · 拖动移动" Foreground="#B8CFC1" FontSize="11" MouseLeftButtonDown="Drag" Cursor="SizeAll"/>
   <Viewbox Grid.Row="1" StretchDirection="DownOnly" Margin="0,3"><TextBlock Text="{Binding RemainingText}" FontSize="46" FontWeight="SemiBold" FontFamily="Consolas" MouseLeftButtonDown="Drag" Cursor="SizeAll"/></Viewbox>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button x:Name="RestMinusButton" Content="− 5 分钟" Tag="-5" Click="Adjust" Background="#3D5147" Margin="0,0,4,0" Padding="6,5"/>
    <Button x:Name="RestPlusButton" Grid.Column="1" Content="+ 5 分钟" Tag="5" Click="Adjust" Background="#3D5147" Margin="4,0,0,0" Padding="6,5"/>
   </Grid>
  </Grid>
 </Border>
</Window>
