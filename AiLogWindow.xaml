<Window x:Class="DoneBubble.AiLogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DoneBubble · AI总结日志" Width="980" Height="680" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="#EDF2F7" FontFamily="Segoe UI, Microsoft YaHei UI" ShowInTaskbar="False" Topmost="False" WindowStartupLocation="CenterScreen">
 <Window.Resources><BooleanToVisibilityConverter x:Key="Bool"/><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="#2B3544" CornerRadius="10" Padding="12"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#3B5364"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Window.Resources><Border Margin="8" Background="#FF202936" CornerRadius="18" BorderBrush="#4C596B" BorderThickness="1" Padding="22" MouseLeftButtonDown="Drag_MouseDown">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="AI总结日志" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="每条日志都对应一条今日记录" Foreground="#A8B5C3" FontSize="12" Margin="0,4,0,0"/></StackPanel><Button Content="×" HorizontalAlignment="Right" Background="Transparent" Padding="8,0" FontSize="20" Click="Close_Click"/></Grid>
   <Grid Grid.Row="1" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid><ListBox x:Name="Logs" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0" DisplayMemberPath="Heading"/><TextBlock Text="还没有 AI 日志。&#10;&#10;在气泡中勾选“AI 总结”，再选择轻 / 中 / 重。" TextWrapping="Wrap" Foreground="#8F9CAC" Margin="8" VerticalAlignment="Center" TextAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource Bool}}"/></Grid><ScrollViewer Grid.Column="1" Margin="22,0,0,0" VerticalScrollBarVisibility="Auto"><StackPanel><Border Background="#2B3544" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="摘要" Foreground="#A8CFC0" FontSize="12"/><TextBlock Text="{Binding Selected.Summary}" FontSize="22" TextWrapping="Wrap" Margin="0,5,0,10"/><TextBlock Text="{Binding Selected.Frames.Count, StringFormat=截图证据：{0} 张}" Foreground="#B8DCCD" FontSize="12"/></StackPanel></Border><Expander Header="查看提示词" Foreground="#B8DCCD" Margin="0,14,0,0"><TextBox Text="{Binding Selected.Prompt}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Background="#151C27" Foreground="#DCE5EE" BorderThickness="0" Padding="12" MinHeight="120"/></Expander><Expander Header="查看模型原始输出" Foreground="#B8DCCD" Margin="0,8,0,0"><TextBox Text="{Binding Selected.RawResponse}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Background="#151C27" Foreground="#DCE5EE" BorderThickness="0" Padding="12" MinHeight="160"/></Expander></StackPanel></ScrollViewer></Grid>
  </Grid>
 </Border>
</Window>
