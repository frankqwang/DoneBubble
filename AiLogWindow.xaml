<Window x:Class="DoneBubble.AiLogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DoneBubble" Title="DoneBubble · AI总结" Width="820" Height="640" MinWidth="620" MinHeight="420" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="#EDF2F7" FontFamily="Segoe UI, Microsoft YaHei UI" ShowInTaskbar="False" Topmost="False" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown">
  <Window.Resources>
    <local:Base64ImageConverter x:Key="Base64Image"/>
  </Window.Resources>
  <Border Margin="8" Background="#FF202936" CornerRadius="18" BorderBrush="#4C596B" BorderThickness="1" Padding="22" MouseLeftButtonDown="Drag_MouseDown">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="AI总结" FontSize="19" FontWeight="SemiBold"/>
          <TextBlock Text="  ·  这条记录的活动证据" FontSize="13" Foreground="#9EAFBE" VerticalAlignment="Center"/>
        </StackPanel>
        <Button Content="×" HorizontalAlignment="Right" Background="Transparent" Padding="8,0" FontSize="20" Click="Close_Click" ToolTip="关闭 (Esc)"/>
      </Grid>
      <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="摘要" Foreground="#A8CFC0" FontSize="13" Margin="0,2,14,0"/>
            <TextBlock Grid.Column="1" Text="{Binding Selected.Summary}" FontSize="20" TextWrapping="Wrap"/>
          </Grid>
          <StackPanel>
            <TextBlock Text="{Binding Selected.Frames.Count, StringFormat=截图证据（{0} 张）}" Foreground="#A8CFC0" FontSize="13" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding Selected.Frames}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate><Border Background="#151C27" CornerRadius="8" Padding="4" Margin="0,0,8,8"><Image Source="{Binding Converter={StaticResource Base64Image}}" Width="180" Height="110" Stretch="Uniform"/></Border></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <TextBlock Text="提示词" Foreground="#A8CFC0" FontSize="13" Margin="0,10,0,6"/>
          <TextBox Text="{Binding Selected.Prompt}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Background="#151C27" Foreground="#DCE5EE" BorderThickness="0" Padding="14" FontSize="14" MinHeight="120"/>
          <TextBlock Text="模型原始输出" Foreground="#A8CFC0" FontSize="13" Margin="0,16,0,6"/>
          <TextBox Text="{Binding Selected.RawResponse}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Background="#151C27" Foreground="#DCE5EE" BorderThickness="0" Padding="14" FontSize="14" MinHeight="180"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
