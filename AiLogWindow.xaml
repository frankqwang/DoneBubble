<Window x:Class="DoneBubble.AiLogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DoneBubble · AI 总结" Width="900" Height="650" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="#EDF2F7" FontFamily="Segoe UI, Microsoft YaHei UI" ShowInTaskbar="False" Topmost="False" WindowStartupLocation="CenterScreen">
 <Window.Resources><BooleanToVisibilityConverter x:Key="Bool"/></Window.Resources><Border Margin="8" Background="#F5222B38" CornerRadius="18" BorderBrush="#4C596B" BorderThickness="1" Padding="20" MouseLeftButtonDown="Drag_MouseDown">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="AI 总结日志" FontSize="23" FontWeight="SemiBold"/><Button Content="×" HorizontalAlignment="Right" Background="Transparent" Padding="8,0" FontSize="20" Click="Close_Click"/></Grid>
   <Grid Grid.Row="1" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid><ListBox x:Name="Logs" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0" DisplayMemberPath="Heading"/><TextBlock Text="还没有 AI 总结日志。&#10;&#10;勾选“AI 总结”，再选择轻 / 中 / 重，成功生成的总结会显示在这里。" TextWrapping="Wrap" Foreground="#8F9CAC" Margin="8" VerticalAlignment="Center" TextAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource Bool}}"/></Grid><ScrollViewer Grid.Column="1" Margin="18,0,0,0" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="摘要" Foreground="#A8CFC0" FontSize="12"/><TextBlock Text="{Binding Selected.Summary}" FontSize="20" TextWrapping="Wrap" Margin="0,5,0,18"/><TextBlock Text="提示词" Foreground="#A8CFC0" FontSize="12"/><TextBox Text="{Binding Selected.Prompt}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Background="#151C27" Foreground="#DCE5EE" BorderThickness="0" Padding="10" MaxHeight="180"/><TextBlock Text="模型原始输出" Foreground="#A8CFC0" FontSize="12" Margin="0,14,0,0"/><TextBox Text="{Binding Selected.RawResponse}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Background="#151C27" Foreground="#DCE5EE" BorderThickness="0" Padding="10"/></StackPanel></ScrollViewer></Grid>
  </Grid>
 </Border>
</Window>
