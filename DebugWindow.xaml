<Window x:Class="DoneBubble.DebugWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DoneBubble · AI 调试" Width="820" Height="760" Background="#202936" Foreground="#EDF2F7" FontFamily="Segoe UI, Microsoft YaHei UI" Topmost="False" WindowStartupLocation="CenterScreen">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="本地 AI 调试" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="主动采集当前窗口上下文 → 发送给 LM Studio → 查看原始输出。不会自动入账。" Foreground="#AAB5C3" Margin="0,5,0,14"/></StackPanel>
  <StackPanel Grid.Row="1" Orientation="Horizontal"><Button Content="采集并分析" Click="Analyze_Click" Padding="14,8"/><Button Content="采集近30秒并分析" Click="AnalyzeSeries_Click" Padding="14,8" Margin="8,0,0,0" Background="#53657A"/><Button Content="截图并分析" Click="AnalyzeImage_Click" Padding="14,8" Margin="8,0,0,0" Background="#3C4B5E"/><Button Content="只采集上下文" Click="Collect_Click" Padding="14,8" Margin="8,0,0,0" Background="#344252"/><CheckBox x:Name="TopmostToggle" Content="置顶调试窗口" Checked="Topmost_Changed" Unchecked="Topmost_Changed" Foreground="#B8DCCD" VerticalAlignment="Center" Margin="16,0,0,0"/><TextBlock x:Name="Status" Text="AI 默认关闭也可以在这里手动测试" Foreground="#A8CFC0" VerticalAlignment="Center" Margin="16,0,0,0"/></StackPanel>
  <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBlock Text="采集到的上下文" FontWeight="SemiBold" Margin="0,0,8,6"/><TextBlock Grid.Column="1" Text="解析后的候选" FontWeight="SemiBold" Margin="8,0,0,6"/>
   <Grid Grid.Row="1" Margin="0,0,8,14"><TextBox x:Name="ContextBox" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="#151C27" Foreground="#DDE6EF" BorderThickness="0" Padding="10"/><Image x:Name="ScreenshotView" Width="210" Height="130" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Stretch="Uniform" Opacity="0.92"/></Grid>
   <TextBox x:Name="ResultBox" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="#151C27" Foreground="#DDE6EF" BorderThickness="0" Padding="10" Margin="8,0,0,14"/>
   <TextBlock Grid.Row="2" Text="发送给模型的完整提示词" FontWeight="SemiBold" Margin="0,0,8,6"/><TextBlock Grid.Row="2" Grid.Column="1" Text="模型原始 HTTP 输出" FontWeight="SemiBold" Margin="8,0,0,6"/>
   <TextBox x:Name="PromptBox" Grid.Row="3" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="#151C27" Foreground="#AAB5C3" BorderThickness="0" Padding="10" Margin="0,0,8,0"/>
   <TextBox x:Name="RawBox" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="#151C27" Foreground="#AAB5C3" BorderThickness="0" Padding="10" Margin="8,0,0,0"/>
  </Grid>
 </Grid>
</Window>
